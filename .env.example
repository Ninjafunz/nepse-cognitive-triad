# ==============================================================================
# NEPSE Cognitive Triad AI Trader Environment Configuration
# ==============================================================================

# Database (PostgreSQL 16 + TimescaleDB + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nepse_triad
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/nepse_triad
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/nepse_triad

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Capital & Trading Simulation
# Equivalent to $100,000 USD (~13,300,000 NPR)
INITIAL_VIRTUAL_CAPITAL_NPR=13300000.00
MAX_PORTFOLIO_CONCENTRATION_PCT=0.15
ENABLE_PAPER_TRADING=true

# NEPSE Market Specifics
NEPSE_MARKET_OPEN_TIME=11:00
NEPSE_MARKET_CLOSE_TIME=15:00
CIRCUIT_BREAKER_NORMAL_PCT=0.10
CIRCUIT_BREAKER_SPECIAL_PCT=0.15
BROKER_COMMISSION_PCT=0.0037
SEBON_FEE_PCT=0.00015
DP_CHARGE_NPR=25.0

# Polling & Ingestion
POLLING_INTERVAL_SECONDS=5
STALE_DATA_THRESHOLD_SECONDS=30
VERIFY_NEPSE_SSL=false

# LLM & RAG Strategy (Local Llama-3 by default)
LLM_PROVIDER=local_llama3
LOCAL_LLAMA3_API_BASE=http://localhost:11434/v1
LOCAL_LLAMA3_MODEL_NAME=llama3:70b
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=optional_if_using_local_llama3

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
